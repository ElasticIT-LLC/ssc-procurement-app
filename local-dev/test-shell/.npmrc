# No GitHub Packages auth required — deps bundled in vendor/

# Vendored shell declares vite ^8 as a peer, but the test-shell intentionally runs vite ^6
# (the prebuilt shell dist works on either). Without this flag, `npm install` fails ERESOLVE on
# the peer-dep mismatch — including the auto-install inside setup.sh step 7. Persistent here
# so every `npm install` in this directory (manual or scripted) honors it.
legacy-peer-deps=true
