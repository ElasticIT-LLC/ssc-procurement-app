{
  "$schema": "./types/app-manifest.schema.json",
  "slug": "procurement",
  "name": "Procurement",
  "icon": "Package",
  "version": "0.3.0",
  "permissions": [
    { "key": "apps/procurement/*", "label": "Full Access", "description": "Full access to Procurement", "group": "Administration" },
    { "key": "apps/procurement/requests/create", "label": "Create requests", "description": "Create and submit purchase requests; mark items received; initiate returns", "group": "Requests" },
    { "key": "apps/procurement/requests/view", "label": "View requests", "description": "View purchase requests", "group": "Requests" },
    { "key": "apps/procurement/approvals/act", "label": "Approve items", "description": "Approve, decline, or hold requested items", "group": "Approvals" },
    { "key": "apps/procurement/purchasing/manage", "label": "Manage purchasing", "description": "Place orders and record shipping for approved items", "group": "Purchasing" },
    { "key": "apps/procurement/returns/manage", "label": "Manage returns", "description": "Process returns and order replacements", "group": "Returns" },
    { "key": "apps/procurement/admin/manage", "label": "Manage settings", "description": "Manage locations, departments, and roles", "group": "Administration" }
  ],
  "pages": [
    { "key": "dashboard",  "label": "Dashboard",  "permission": "apps/procurement/requests/view" },
    { "key": "requests",   "label": "Requests",   "permission": "apps/procurement/requests/view" },
    { "key": "approvals",  "label": "Approvals",  "permission": "apps/procurement/approvals/act" },
    { "key": "purchasing", "label": "Purchasing", "permission": "apps/procurement/purchasing/manage" },
    { "key": "returns",    "label": "Returns",    "permission": "apps/procurement/returns/manage" },
    { "key": "records",    "label": "Records",    "permission": "apps/procurement/admin/manage" },
    { "key": "admin",      "label": "Admin",      "permission": "apps/procurement/admin/manage" }
  ],
  "database": {
    "mode": "schema",
    "schema": "app_procurement",
    "migrations": [
      { "version": 1, "description": "Core tables + seed", "up": "migrations/001_initial.sql" },
      { "version": 2, "description": "Workflow RPCs + row-ownership RLS", "up": "migrations/002_rpcs_and_rls.sql" },
      { "version": 3, "description": "Records (admin_comment + item RPCs) + requester capture", "up": "migrations/003_records_and_polish.sql" },
      { "version": 4, "description": "Enable RLS on purchase_requests + line_items (policies were inert)", "up": "migrations/004_enable_rls.sql" },
      { "version": 5, "description": "Phase 2a: product-images bucket + get_app_secret + get_permission_holders", "up": "migrations/005_images_secrets_recipients.sql" }
    ],
    "tables": [
      { "name": "locations",         "rls": { "read": "authenticated", "write": "admin" } },
      { "name": "departments",       "rls": { "read": "authenticated", "write": "admin" } },
      { "name": "purchase_requests", "rls": { "read": "authenticated", "write": "authenticated" } },
      { "name": "line_items",        "rls": { "read": "authenticated", "write": "authenticated" } },
      { "name": "_config",           "rls": { "read": "admin", "write": "admin" } }
    ]
  },
  "notifications": [
    { "key": "request_submitted", "label": "New request to approve", "description": "A new purchase request was submitted and needs approval.", "sort_order": 1 },
    { "key": "item_approved", "label": "Item approved", "description": "A requested item was approved.", "sort_order": 2 },
    { "key": "item_declined", "label": "Item declined", "description": "A requested item was declined.", "sort_order": 3 },
    { "key": "item_ordered", "label": "Item ordered", "description": "An approved item was ordered.", "sort_order": 4 },
    { "key": "return_initiated", "label": "Return initiated", "description": "A return was initiated for a received item.", "sort_order": 5 }
  ],
  "edge_functions": [
    { "name": "procurement-capture-and-notify", "entrypoint": "supabase/functions/procurement-capture-and-notify/index.ts", "verify_jwt": false }
  ],
  "vault_secrets": [
    { "name": "SCREENSHOT_API_KEY", "source": "admin-input", "description": "x-api-key for the msr-screenshot Azure container app (used server-side by procurement-capture-and-notify to capture product screenshots)." }
  ]
}
