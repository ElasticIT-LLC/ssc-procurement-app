node_modules
dist
.env
.env.*
!.env.example
*.eitapp
.claude/settings.local.json
local-dev/supabase/.temp/
local-dev/supabase/.branches/
# Shell migrations + edge functions are copied by setup.sh from
# node_modules/@elasticit-llc/shell/supabase on each fresh boot — runtime
# artifacts, not source.
local-dev/supabase/functions/
local-dev/supabase/migrations/
local-dev/test-shell/node_modules
# Test-shell lockfile is regenerated by setup.sh's `npm install` step
# (which now reads `legacy-peer-deps=true` from .npmrc). Not committed
# to keep diffs clean across machines/Node versions.
local-dev/test-shell/package-lock.json
local-dev/brand.json
local-dev/test-shell/src/generated-brand.css
local-dev/test-shell/src/generated-brand.ts
# Marker file written by local-dev/setup.sh on first successful init —
# subsequent runs see it and skip the slow migration/user/seed steps when
# the Supabase stack is still up.
local-dev/.setup-complete
*.tsbuildinfo
